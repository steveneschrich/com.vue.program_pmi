      - "pmi_network"
    extra_hosts:
      impactme: 10.6.203.22

  pmi_zotero_translation:
    image: pmi_zotero_translation:1.0
    build: ./translation-server
    container_name: pmi_zotero_translation
    restart: always
    ports: 
